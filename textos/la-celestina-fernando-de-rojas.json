  "chapters": [
    {
      "slug": "prologo",
      "title": "Prólogo",
      "summary": "Empieza: «Todas las cosas ser criadas a manera de contienda o batalla, dize aquel gran sabio Eráclito en este modo: «Omnia secundum litem…»",
      "start": 0,
      "end": 7
    },
    {
      "slug": "argumento-de-toda-la-obra",
      "title": "Argumento de toda la obra",
      "summary": "Empieza: «Calisto fue de noble linaje, de claro ingenio, de gentil disposición, de linda crianza, dotado de muchas gracias, de estado mediano. Fue…»",
      "start": 8,
      "end": 13
    },
    {
      "slug": "acto-1",
      "title": "Acto I",
      "summary": "Empieza: «En esto veo, Melibea, la grandeza de Dios.»",
      "start": 14,
      "end": 299
    },
    {
      "slug": "acto-2",
      "title": "Acto II",
      "summary": "Empieza: «Hermanos míos, cient monedas di a la madre. ¿Fize bien?»",
      "start": 300,
      "end": 333
    },
    {
      "slug": "acto-3",
      "title": "Acto III",
      "summary": "Empieza: «¡Qué espacio lleua la barvuda! ¡Menos sosiego trayan sus pies a la venida! A dineros pagados, braços quebrados. ¡Ce!, señora Celestina: poco…»",
      "start": 334,
      "end": 369
    },
    {
      "slug": "acto-4",
      "title": "Acto IV",
      "summary": "Empieza: «Agora, que voy sola, quiero mirar bien lo que Sempronio ha temido deste mi camino. Porque aquellas cosas, que bien no son…»",
      "start": 370,
      "end": 479
    },
    {
      "slug": "acto-5",
      "title": "Acto V",
      "summary": "Empieza: «¡O rigurosos trances! ¡O cruda osadía! ¡O gran sofrimiento! ¡E qué tan cercana estuue de la muerte, si mi mucha astucia no…»",
      "start": 480,
      "end": 507
    },
    {
      "slug": "acto-6",
      "title": "Acto VI",
      "summary": "Empieza: «¿Qué dizes, señora e madre mía?»",
      "start": 508,
      "end": 617
    },
    {
      "slug": "acto-7",
      "title": "Acto VII",
      "summary": "Empieza: «Pármeno hijo, después de las passadas razones, no he hauido oportuno tiempo para te dezir e mostrar el mucho amor, que te…»",
      "start": 618,
      "end": 720
    },
    {
      "slug": "acto-8",
      "title": "Acto VIII",
      "summary": "Empieza: «El octauo aucto ARGUMENTO DEL OCTAUO AUTO La mañana viene. Despierta Pármeno. Despedido de Areusa, va para casa de Calisto su señor.…»",
      "start": 721,
      "end": 802
    },
    {
